# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# `mix hex.build` output: the package tarball and the folder `--unpack` writes.
mishka_pay-*.tar
/mishka_pay-*/

# Temporary files, for example, from tests.
/tmp/

# MishkaInstaller keeps its plugin registry in Mnesia, on disk. A stale row can name a module that
# no longer exists, and every hook for that event then refuses to run. Local state, never source.
/.mnesia/
MnesiaCore.*

# Provider keys for the real-service tests. Never committed.
.env*

# macOS Finder metadata
.DS_Store

# The test database's schema is made by `mix ash.codegen` from the test resources: a build artifact,
# never written by hand. CI makes it with `mix ash.codegen ci`.
/priv/repo/migrations/
/priv/resource_snapshots/
